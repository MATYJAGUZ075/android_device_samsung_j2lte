# System properties específicas de j2lte (formato LOS20: system.prop,
# consumido via TARGET_SYSTEM_PROP en BoardConfig.mk).

# Dalvik/Art.
#
# FIX-021 (04/10/2026): heapsize de 512m a 256m.
#
# El comentario decia "1.5GB RAM" y el valor estaba chose para eso, pero el
# device tiene 880 MB REALES. Medido en /proc/meminfo con el build
# 20.0-20261003-UNOFFICIAL-j2lte:
#
#   MemTotal:  900556 kB     <- 880 MB, no 1.5 GB
#   MemFree:   ~83000 kB
#   GL mtrack: 125423 kB  +  EGL mtrack: 57148 kB  = 178 MB solo en graficos
#   dalvik.vm.heapsize = 512m  (el valor que traia esta linea)
#
# Con 512m de heap, 178 MB de graficos y el LMK in-kernel roto
# ("lowmemorykiller: kernel lmk event file could not be opened; errno=2", o
# sea que nadie libera memoria bajo presion), la presion es constante. Sintoma
# medido en el telefono:
#
#   E ion: ioctl c0144900 failed with code -1: Out of memory   (system_server)
#     -> el AudioTrack no puede reservar sus buffers DMA
#     -> E SoundPool::Sound: doLoad: unable to load sound
#     -> dumpsys media.audio_flinger: numTracks=0, Total writes: 0
#     -> ningun sonido
#
# A 256m el heap entra con holgura en 880 MB.
#
# OJO: esto NO explica por si solo el crash de system_server. Ese es eBPF
# ausente (FIX-020, parche 0002-appprofessor-skip-gpu-mem-bpf.patch en el repo
# j2lte-build). Son dos problemas distintos que conviven en el mismo device.
#
# Ajustes de ART para el equipo de 814 MB (FIX-042). Medido:
#   $ grep MemTotal /proc/meminfo
#   MemTotal:         833904 kB
#   $ cat /proc/swaps
#   /dev/block/vnswap0   partition  1048572  328536  -1
#
# El heap por app baja a 192m y la liberacion de heap es mas agresiva
# (heaptargetutilization 0.5, heapmaxfree 2m). El limite de 512 MB del
# compilador de dex (dex2oat) baja a 192m para no tirar de 512 MB de RAM
# durante el arranque, y se quita el segundo pase de dexopt.
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=96m
dalvik.vm.heapsize=192m
dalvik.vm.heaptargetutilization=0.5
dalvik.vm.heapminfree=1m
dalvik.vm.heapmaxfree=2m

# Radio (blob libsec-ril.so / módem tss310)
telephony.lteOnCdmaDevice=0
persist.radio.sib16_support=0
rild.libpath=/system/lib/libsec-ril.so
rild.libargs=-d /dev/ttyS0
ro.telephony.default_network=9
ro.use_data_netmgrd=false
persist.data.netmgrd.qos.enable=false
ro.smps.enable=true
# TODO(fase 5): props legacy del RIL — verificar cuáles sigue leyendo la capa
# RIL de Lineage 20; eliminar las que queden huérfanas.
ro.ril.telephony.mqanelements=6
ro.telephony.get_imsi_from_sim=true
ro.ril.force_eri_from_xml=true
ro.ril.hsxpa=1
ro.ril.gprsclass=10

# Bluetooth: perfiles del stack de A13.
#
# En A13 el app de Bluetooth arranca cada servicio de perfil segun
# XxxService.isEnabled(), que devuelve
# BluetoothProperties.isProfileXxxEnabled().orElse(false). Si la sysprop no
# existe, el perfil queda deshabilitado y su servicio nunca arranca.
#
# En este build no habia ninguna de esas sysprops, asi que el unico perfil que
# arrancaba era GATT (que el stack asume soportado). Medido en el telefono:
#
#   $ dumpsys bluetooth_manager
#     Enabled Profile Services:
#       GattService
#     A2DP State:
#     A2DP Source State: Disabled
#     A2DP Sink State: Disabled
#     AVRCP Target Service not started
#   $ dumpsys activity services com.android.bluetooth
#     * ServiceRecord{... com.android.bluetooth/.btservice.AdapterService}
#     * ServiceRecord{... com.android.bluetooth/.gatt.GattService}
#   $ getprop bluetooth.profile.a2dp.source.enabled
#     (vacio: la propiedad no existe)
#
# Con eso el auricular aparecia y se emparejaba, pero ningun perfil se
# conectaba nunca. El log del stack lo deja claro:
#
#   W A2dpService: getA2dpService(): service is null
#   D CachedBluetoothDevice: No profiles. Maybe we will connect later for device 41:42:e2:88:4e:5a
#   I bt_btif_dm: Bond state changed to state=2 [bonded]
#   I bt_btif_dm: SDP search done (encuentra 110b A2DP, 110e AVRCP, 111e)
#   W l2c_link: l2c_link_timeout
#   I btm_acl : Disconnecting peer reason:Remote Terminated Connection
#
# O sea: el enlace ACL se levanta, se autentica, se empareja y el SDP encuentra
# los UUIDs correctos, pero como no hay servicio A2DP que abra su canal
# L2CAP, el enlace se queda ocioso y a los 4 s el L2CAP da timeout y tira la
# conexion. El auricular "sale" pero nunca queda conectado.
#
# Se habilitan los perfiles que este equipo puede hacer de verdad:
#   a2dp.source        -> audio del telefono a los auriculares
#   avrcp.controller   -> control de medios (play/pausa) en el auricular
#   hfp.hf             -> manos libres
#   hid.host/device    -> teclado y raton por BT
#   pbap.client        -> agenda
#   pan.nap            -> tethering
#   opp                -> transferencia de archivos
#   map.client         -> SMS/MMS
#   gatt               -> BLE
#
# Los de audio LE, LE Audio, CSIP, HAP, ASHA, BASS, MCP, SAP, MAP/PBAP server y
# A2DP sink quedan apagados: este equipo no tiene el hardware ni el caso de uso
# (no es un altavoz, no hace de sink de audio, no hay LE Audio).
bluetooth.profile.gatt.enabled=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.controller.enabled=true
bluetooth.profile.hfp.hf.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.pbap.client.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.map.client.enabled=true

bluetooth.profile.a2dp.sink.enabled=false
bluetooth.profile.avrcp.target.enabled=false
bluetooth.profile.map.server.enabled=false
bluetooth.profile.pbap.server.enabled=false
bluetooth.profile.sap.server.enabled=false
bluetooth.profile.mcp.server.enabled=false
bluetooth.profile.pan.panu.enabled=false
bluetooth.profile.hap.client.enabled=false
bluetooth.profile.hfp.ag.enabled=false
bluetooth.profile.asha.central.enabled=false
bluetooth.profile.bap.broadcast.assist.enabled=false
bluetooth.profile.bap.broadcast.source.enabled=false
bluetooth.profile.bap.unicast.client.enabled=false
bluetooth.profile.bas.client.enabled=false
bluetooth.profile.bass.client.enabled=false
bluetooth.profile.ccp.server.enabled=false
bluetooth.profile.csip.set_coordinator.enabled=false
bluetooth.profile.vcp.controller.enabled=false

#
# Modo de bajo consumo (FIX-042). El equipo tiene 814 MB utiles, asi que el
# presupuesto de RAM es el recurso mas escaso: ro.low_ramdevice y
# ro.config.low_ram hacen que A13 entre en modo de bajo consumo, con menos
# servicios del sistema y limites de procesos en background mas agresivos.
#
# NOTA: no se toca el swap. El unico low-memory killer que funciona en este
# kernel es el de Samsung (lmkd de A13 necesita PSI, y CONFIG_PSI no esta:
# /proc/pressure/memory no existe), asi que quitar el swap dejaria al
# sistema sin red de seguridad y una subida de memoria mataria procesos del
# sistema en vez de apps.
ro.low_ramdevice=true
ro.config.low_ram=true
