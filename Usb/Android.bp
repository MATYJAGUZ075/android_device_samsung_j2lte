// Utilidad USB del J2.
//
// Es una app de sistema (platform-signed, privileged) porque escribe
// sys.usb.config (SET_PROPERTY) y publica la notificacion de "USB conectado".
//
// El panel de "Optimizaciones" ya no vive aqui: esta dentro de la propia app
// de Ajustes (Ajustes -> Sistema -> Optimizaciones).
//
// La UI se construye en codigo (LinearLayout + Spinner + Button) para no
// depender de androidx ni de layouts: compila con el SDK normal.
android_app {
    name: "j2lte-usb",
    srcs: ["src/com/android/settings/j2lte/UsbFunctionActivity.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    privileged: true,
    certificate: "platform",
}
