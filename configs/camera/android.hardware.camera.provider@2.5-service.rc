# Proveedor de camara (HIDL 2.5) del blob de Samsung.
#
# El servicio se llama "legacy" porque lo que se registra es el passthrough
# heredado, no un provider nativo de A13: el init espera exactamente
#
#   android.hardware.camera.provider@2.4::ICameraProvider/legacy/0
#
# y si esa linea no esta, el servicio no llega a arrancar. Medido en el
# telefono con la linea quitada:
#
#   init: Control message: Could not find
#   'android.hardware.camera.provider@2.4::ICameraProvider/legacy/0'
#   init.svc.vendor.camera-provider-2-5: (vacio)
#
# Ademas, arrancar el provider sin "disabled" hacia que el passthrough
# heredado entrara en bucle de crashes (SIGSEGV en
# CameraModule::notifyDeviceStateChange, 26 veces cada 25 s), porque el HAL de
# debajo no se inicializaba: le faltaba el simbolo
# _ZN7android16CameraParameters7KEY_ISOE, que aporta libcamera_client_shim.so.
# Esa libreria ya se empaqueta (FIX-036), y con ella el HAL abre bien.
#
# OJO con la sintaxis de "interface": init quiere DOS argumentos (el nombre y
# la instancia) separados por un espacio. Pegadas con "/" (como estaba antes)
# init lo rechaza con "interface requires 2 arguments" y la declaracion se
# pierde.
service vendor.camera-provider-2-5 /vendor/bin/hw/android.hardware.camera.provider@2.5-service
    class hal
    user cameraserver
    group audio camera input drmrpc
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
    interface android.hardware.camera.provider@2.4::ICameraProvider legacy/0
    interface android.hardware.camera.provider@2.5::ICameraProvider legacy/0
