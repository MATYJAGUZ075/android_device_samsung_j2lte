// HAL de luces propio.
//
// En lineage-20 no existe android.hardware.light@2.0-service.samsung
// (hardware/samsung no tiene el directorio lights), y android.hardware.light
// quedo fuera del manifest VINTF para que LightsService no se colgara
// esperando un servicio inexistente. El resultado es que en A13 el brillo de
// la pantalla no llega a ningun lado: DisplayPowerController usa un
// BacklightAdapter que envuelve LightsService$LightImpl, y sin HAL el
// framework guarda el valor pero no lo aplica.
//
// Medido en el telefono con este arbol:
//   $ dumpsys display
//     mBacklightAdapter=BacklightAdapter [... backlight=LightsService$LightImpl@...]
//     mDisplayDeviceConfig=DisplayDeviceConfig{... mBacklight=null, mRawBacklight=null ...}
//   $ dumpsys lights
//     Service: hidl
//     Light id=0 ordinal=1 color=ff3e3e3e
//     Session clients:
//   $ lshal | grep light
//     (nada: no hay ningun android.hardware.light@2.0::ILight/default)
//
// Este servicio implementa ILight y escribe el brillo en el sysfs del panel.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// La implementacion se compila como libreria estatica y se linka DENTRO del
// binario del servicio, no como una .so separada.
//
// Con cc_library_shared la .so acababa en /vendor/lib/hw/ y el servicio
// muria al arrancar:
//
//   F/linker: CANNOT LINK EXECUTABLE
//     "/vendor/bin/hw/android.hardware.light@2.0-service.samsung":
//     library "android.hardware.light@2.0-impl.samsung.so" not found:
//     needed by main executable
//
// El linker de los binarios de vendor busca en /vendor/lib, no en
// /vendor/lib/hw/ (esa carpeta solo existe para las .so de los HAL del
// fabricante, que se linkan dentro de su binario: en el mismo vendor,
// android.hardware.keymaster@3.0-service no lista su impl como DT_NEEDED).
// Ademas la plataforma hace lo mismo con relative_install_path "hw" en
// hardware/interfaces/light/2.0/default/Android.bp, pero alli la .so la
// carga el servicio "default" por dlopen, no por DT_NEEDED.
cc_library_static {
    name: "j2lte_light_impl",
    defaults: ["hidl_defaults"],
    vendor: true,
    srcs: ["Light.cpp"],

    shared_libs: [
        "libbase",
        "liblog",
        "libhidlbase",
        "libutils",
        "android.hardware.light@2.0",
    ],
}

// El nombre lleva prefijo j2lte_ a proposito: la plataforma ya define un
// cc_defaults llamado "light_service_defaults" en
// hardware/interfaces/light/2.0/default/Android.bp, y en Soong los nombres de
// modulo son globales al arbol. Con el mismo nombre el build abortaba:
//
//   FAILED: out/soong/build.ninja
//   error: hardware/interfaces/light/2.0/default/Android.bp:42:1:
//          module "light_service_defaults" already defined
//   ninja: build stopped: subcommand failed.
//
// Ademas, sin el prefijo el cc_binary de abajo se habria enlazado con los
// defaults de la plataforma en vez de los suyos.
cc_defaults {
    name: "j2lte_light_service_defaults",
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    vendor: true,

    shared_libs: [
        "liblog",
        "libbase",
        "libdl",
        "libutils",
        "libhidlbase",
        "android.hardware.light@2.0",
    ],
}

cc_binary {
    name: "android.hardware.light@2.0-service.samsung",
    defaults: ["j2lte_light_service_defaults"],
    init_rc: ["android.hardware.light@2.0-service.rc"],
    srcs: ["service.cpp"],
    static_libs: ["j2lte_light_impl"],
}
