<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest VINTF del device para LineageOS 20 (Android 13).
     Estrategia del porte (referencia: universal7420 en LOS 20):
     - target-level="3" (FCM de Android R) permite mantener HALs HIDL legacy.
     - Cada HAL declarada corresponde a algo que el J2 puede proporcionar
       vía código propio, hardware/samsung o blobs existentes.
     - Las entradas marcadas TODO se ajustan en fases posteriores.
     Se instala via DEVICE_MANIFEST_FILE (ver BoardConfig.mk). -->
<manifest version="1.0" type="device" target-level="3">
    <!-- Audio: HIDL 7.x sobre audio.primary.universal3475 (passthrough 32-bit).
         TODO(fase 4): requiere portar el primary HAL a la API 7.x. -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport arch="32">passthrough</transport>
        <version>7.1</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport arch="32">passthrough</transport>
        <version>7.0</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Bluetooth: HCI HIDL 1.0 custom (universal3475-common/hardware/bluetooth).
         Enfoque validado por Exynos7420 en LOS 20/21. -->
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IBluetoothHci</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Camera: wrapper legacy contra provider 2.4.
         TODO(fase 3): evaluar subida a 2.5 (instancia legacy/0). -->
    <hal format="hidl">
        <name>android.hardware.camera.provider</name>
        <transport>hwbinder</transport>
        <version>2.4</version>
        <interface>
            <name>ICameraProvider</name>
            <instance>legacy/0</instance>
        </interface>
    </hal>
    <!-- DRM: framework + clearkey software; Widevine L3 vía blobs. -->
    <hal format="hidl">
        <name>android.hardware.drm</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ICryptoFactory</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IDrmFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- GNSS: gpsd blob + wrapper 1.0 (universal3475-common). -->
    <hal format="hidl">
        <name>android.hardware.gnss</name>
        <transport arch="32">passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>IGnss</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Graphics: stack SLSI exynos5 legacy con adapters HWC1->HWC2.
         TODO(fase 2): validar compilación y runtime de composer/allocator. -->
    <hal format="hidl">
        <name>android.hardware.graphics.allocator</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>IAllocator</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.graphics.composer</name>
        <transport arch="32">passthrough</transport>
        <version>2.1</version>
        <interface>
            <name>IComposer</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.graphics.mapper</name>
        <transport arch="32">passthrough</transport>
        <version>2.1</version>
        <interface>
            <name>IMapper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Health 2.1 (requisito mínimo práctico en T). -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>backup</instance>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Keymaster 3.0 + TEE mobicore (enfoque Exynos7420 en LOS 20).
         Plan B documentado en ANALISIS_LINEAGE20_REFERENCIAS.md: soft KM 4. -->
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>3.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Lights: android.hardware.light@2.0-service.samsung (hardware/samsung). -->
    <hal format="hidl">
        <name>android.hardware.light</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>ILight</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Media OMX: codecs SLSI Samsung (openmax) — enfoque mantenido por
         universal7420 en LOS 20. TODO(fase 4): evaluar Codec2. -->
    <hal format="hidl">
        <name>android.hardware.media.omx</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IOmx</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IOmxStore</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.memtrack</name>
        <transport arch="32">passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>IMemtrack</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Power: HAL samsung exynos. TODO(fase 4): decidir entre power@1.0
         legacy y power-service.samsung-libperfmgr + powerhint.json. -->
    <hal format="hidl">
        <name>android.hardware.power</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IPower</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Radio: rild legacy + libsec-ril (tss310).
         TODO(fase 5): re-trabajo completo hacia radio@1.2-1.4 estilo 7420;
         radio.deprecated@1.0 se elimina cuando eso ocurra. -->
    <hal format="hidl">
        <name>android.hardware.radio</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IRadio</name>
            <instance>slot1</instance>
        </interface>
        <interface>
            <name>ISap</name>
            <instance>slot1</instance>
        </interface>
    </hal>
    <!-- Sensors: blob sensors.universal3475.so vía passthrough 1.0.
         TODO(fase 4): wrapper multihal si hace falta. -->
    <hal format="hidl">
        <name>android.hardware.sensors</name>
        <transport arch="32">passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>ISensors</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- USB básico. -->
    <hal format="hidl">
        <name>android.hardware.usb</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IUsb</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Vibrator. -->
    <hal format="hidl">
        <name>android.hardware.vibrator</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IVibrator</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Wi-Fi: bcmdhd + wpa_supplicant VER_0_8_X con WPA_SUPPLICANT_USE_HIDL
         (receta validada en LOS 20 por universal7420). -->
    <hal format="hidl">
        <name>android.hardware.wifi.hostapd</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IHostapd</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.wifi.supplicant</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>ISupplicant</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- HALs Lineage específicas del dispositivo. -->
    <!-- Touch: key disabler / gestures. TODO: verificar disponibilidad en
         hardware/samsung lineage-20 (fase 4). -->
    <hal format="hidl">
        <name>vendor.lineage.touch</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IKeyDisabler</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>ITouchscreenGesture</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Trust HAL. TODO: vendor.lineage.trust fue retirado del árbol Lineage
         en versiones recientes; eliminar esta entrada si no se mantiene. -->
    <hal format="hidl">
        <name>vendor.lineage.trust</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IUsbRestrict</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- ELIMINADAS respecto al manifest 17.1 (muertas en A13 o sin implementación planificada):
         - android.hardware.cas               (sin uso)
         - android.hardware.configstore       (eliminado en A12; usar disable_configstore)
         - android.hardware.radio.deprecated  (se elimina en fase 5)
         - android.hardware.renderscript      (deprecado/eliminado en T)
         - vendor.lineage.power               (reemplazado por power HAL moderna) -->
</manifest>
