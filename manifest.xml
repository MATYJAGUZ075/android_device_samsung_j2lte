<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest VINTF del device para LineageOS 20 (Android 13).
     Estrategia del porte (referencia: universal7420 en LOS 20):
     - target-level="3" (FCM de Android R) permite mantener HALs HIDL legacy.
     - Cada HAL declarada corresponde a algo que el J2 puede proporcionar
       vía código propio, hardware/samsung o blobs existentes.
     - Las entradas marcadas TODO se ajustan en fases posteriores.
     Se instala via DEVICE_MANIFEST_FILE (ver BoardConfig.mk). -->
<manifest version="1.0" type="device" target-level="3">
    <!-- Audio: HIDL 7.x binderizado (android.hardware.audio.service).
         FIX-AUDIO: MEDIDO en la run 36957930373 (02/10/2026) y CONFIRMADO
         on-device el 02/10/2026. El sistema no terminaba de arrancar: 8 ANRs
         de system_server, todos bloqueados en AudioService.<init> ->
         AudioSystem::listAudioProductStrategies -> getService("audio_policy").
         Esa espera no tiene timeout; el watchdog mataba a system_server y el
         dispositivo reiniciaba en bucle (bootanimation -> negro -> bootanimation).

         Causa raiz (confirmada on-device): /vendor/bin/hw/android.hardware.audio.service
         abortaba con SIGABRT y 'Could not register Audio Core API' porque
         android.hardware.audio@7.1::IDevicesFactory/default no estaba
         declarado en el manifiesto VINTF, y el servicio es BINDERIZADO:
             E HidlServiceManagement: Service android.hardware.audio@7.1::
             IDevicesFactory/default must be in VINTF manifest in order to
             register/get.
             E LegacySupport: Could not register service ... (-2147483648)
         La declaracion previa usaba <transport arch="32">passthrough</transport>,
         que hwservicemanager rechaza para un servicio que se registra en
         hwbinder. NO era un problema de vndbinder (hipotesis descartada).

         Fix: declarar ambas HALs como hwbinder.
         Verificado on-device: con esta entrada el audio deja de abortar (cero
         tombstones de audio tras el reinicio) y el sistema arranca hasta
         SystemUI. Nota: configstore@1.1 sigue abortando por la misma razon
         (entrada retirada en 3772df5) pero ya no bloquea el arranque.

         Restauracion de audio funcional (calidad, no solo registro) pendiente
         en ANOMALIAS-BUGS-J2-2026-09-30.md (seccion BG). -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <version>7.1</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <version>7.0</version>
        <interface>
            <name>IEffectsFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Bluetooth: HCI HIDL 1.0 custom (universal3475-common/hardware/bluetooth).
         Enfoque validado por Exynos7420 en LOS 20/21. -->
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IBluetoothHci</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Camera: wrapper legacy contra provider 2.4.
         TODO(fase 3): evaluar subida a 2.5 (instancia legacy/0). -->
    <hal format="hidl">
        <name>android.hardware.camera.provider</name>
        <transport>hwbinder</transport>
        <version>2.4</version>
        <interface>
            <name>ICameraProvider</name>
            <instance>legacy/0</instance>
        </interface>
    </hal>
    <!-- DRM: framework + clearkey software; Widevine L3 vía blobs. -->
    <hal format="hidl">
        <name>android.hardware.drm</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ICryptoFactory</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IDrmFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- GNSS: gpsd blob + wrapper 1.0 (universal3475-common). -->
    <hal format="hidl">
        <name>android.hardware.gnss</name>
        <transport arch="32">passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>IGnss</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Graphics: stack SLSI exynos5 legacy con adapters HWC1->HWC2.
         TODO(fase 2): validar compilación y runtime de composer/allocator. -->
    <hal format="hidl">
        <name>android.hardware.graphics.allocator</name>
        <transport>hwbinder</transport>
        <version>2.0</version>
        <interface>
            <name>IAllocator</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.graphics.composer</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IComposer</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.graphics.mapper</name>
        <transport arch="32">passthrough</transport>
        <version>2.1</version>
        <interface>
            <name>IMapper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Health 2.1 (requisito mínimo práctico en T). -->
    <hal format="hidl">
        <name>android.hardware.health</name>
        <transport>hwbinder</transport>
        <version>2.1</version>
        <interface>
            <name>IHealth</name>
            <instance>backup</instance>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Keymaster 3.0 (soft, sin TEE) — RE-ACTIVADO (03/10/2026).
         El bootloop real NO era por keymaster ni por falta de TEE: era el
         binder del kernel 3.10 sin BR_TRANSACTION_SEC_CTX (calling_sid) ->
         keystore2 no podia chequear permisos. Ver seccion BL de
         ANOMALIAS-BUGS-J2-2026-09-30.md (fix de kernel `13eaf70c`).

         Se habia retirado en 1f88930 (FIX-KEYMASTER, preventivo y NO medido).
         Se re-activa para mantener paridad con el dispositivo: el servicio
         /vendor/bin/hw/android.hardware.keymaster@3.0-service existe
         (class early_hal) y el sistema arranca con esta declaracion. Es el
         keymaster SOFTWARE (impl enlaza libsoftkeymasterdevice), sin TEE. -->
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>3.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Lights: android.hardware.light@2.0-service.samsung (hardware/samsung).
         FIX-024: ese servicio NO existe en hardware/samsung lineage-20 (no hay
         dir lights), igual que paso con power@1.0 (FIX-035). Con el HAL
         declarado y sin implementacion, LightsService.setLight_native() pide el
         servicio, getRawServiceInternal() se queda en Waiter::wait(), el main
         thread de system_server se bloquea y el watchdog reinicia el sistema en
         bucle. Medido on-device: 4 dumps de "Blocked in handler on main thread"
         con este stack exacto, y el sistema nunca llegaba a boot_completed.

         Se desactiva la declaracion, igual que se hizo con power en FIX-035.
         LightsService cae al path sin-HAL: arranca el boot. Se pierde el LED de
         notificaciones y el brillo automatico (que ya no funcionaban porque el
         sistema reiniciaba antes de llegar a usarlos).

         Verificado en el dispositivo antes de aplicar: el manifest parsea como
         XML valido y queda en 17 <hal> activos. -->
    <!--FIX-LIGHT     <hal format="hidl"> -->
    <!--FIX-LIGHT         <name>android.hardware.light</name> -->
    <!--FIX-LIGHT         <transport>hwbinder</transport> -->
    <!--FIX-LIGHT         <version>2.0</version> -->
    <!--FIX-LIGHT         <interface> -->
    <!--FIX-LIGHT             <name>ILight</name> -->
    <!--FIX-LIGHT             <instance>default</instance> -->
    <!--FIX-LIGHT         </interface> -->
    <!--FIX-LIGHT     </hal> -->
    <!-- Media OMX: codecs SLSI Samsung (openmax) — enfoque mantenido por
         universal7420 en LOS 20. TODO(fase 4): evaluar Codec2. -->
    <hal format="hidl">
        <name>android.hardware.media.omx</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IOmx</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IOmxStore</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.memtrack</name>
        <transport arch="32">passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>IMemtrack</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Power: NO se declara aqui. FIX-035: se declara el HIDL power@1.0 pero
         no hay ningun HAL que lo implemente (power@1.0-service.exynos no existe
         en LOS20), y PowerManagerService.nativeInit() se queda esperando el
         servicio para siempre -> ANR -> bucle de reinicios. La implementacion
         real es el AIDL android.hardware.power-service.samsung-libperfmgr, que
         instala su propio fragment VINTF con override="true". Declarar el HIDL
         ademas provocaria el conflicto de version mayor que se vio con USB. -->

    <!-- Radio: rild legacy + libsec-ril (tss310).
         TODO(fase 5): re-trabajo completo hacia radio@1.2-1.4 estilo 7420;
         radio.deprecated@1.0 se elimina cuando eso ocurra. -->
    <hal format="hidl">
        <name>android.hardware.radio</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>IRadio</name>
            <instance>slot1</instance>
        </interface>
        <interface>
            <name>ISap</name>
            <instance>slot1</instance>
        </interface>
    </hal>
    <!-- Sensors: blob sensors.universal3475.so vía passthrough 1.0.
         TODO(fase 4): wrapper multihal si hace falta. -->
    <hal format="hidl">
        <name>android.hardware.sensors</name>
        <transport arch="32">passthrough</transport>
        <version>1.0</version>
        <interface>
            <name>ISensors</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Configstore 1.1 — FIX-CONFIGSTORE-RESTORE.
         El binario /vendor/bin/hw/android.hardware.configstore@1.1-service SÍ se
         construye e init lo arranca. Sin esta entrada su registerAsService()
         falla con "must be in VINTF manifest in order to register/get" y el
         servicio entra en crash-loop (18 tombstones medidos on-device; el
         tombstone muestra Cmdline /vendor/bin/hw/android.hardware.configstore@1.1-service).
         El comentario antiguo que afirmaba que no existía el binario es falso.
         Re-declararlo detiene el crash-loop. Riesgo de cuelgue descartado:
         nadie consume ISurfaceFlingerConfigs en A13 y el servicio ya existe. -->
    <hal format="hidl">
        <name>android.hardware.configstore</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>ISurfaceFlingerConfigs</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.1::ISurfaceFlingerConfigs/default</fqname>
    </hal>
    <!-- USB (FIX-034): NO se declara aquí. android.hardware.usb@1.0-service.basic
         (device-common.mk) instala su propio VINTF fragment
         (android.hardware.usb@1.0-service.basic.xml). Declararlo también en el
         manifest device provoca el conflicto libvintf "Conflicting major version:
         1.0 (manifest.xml) vs. 1.0 (fragment)" que aborta el ensamblado VINTF
         combinado -> TODAS las HALs fallan con registerAsService()=-2147483648
         (fallo raíz diagnosticado en el J2, limpio tras retirar el fragment). -->
    <!-- Vibrator. -->
    <hal format="hidl">
        <name>android.hardware.vibrator</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IVibrator</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- Wi-Fi (FIX-017): en LOS20 hostapd/supplicant son AIDL y quedan
         declarados por external/wpa_supplicant_8 vía LOCAL_VINTF_FRAGMENTS
         (android.hardware.wifi.{hostapd,supplicant}, fqname default).
         No declarar aquí las versiones HIDL sin implementación. -->
        <!-- HALs Lineage específicas del dispositivo. -->
    <!-- Touch — FIX-026: bloque retirado TEMPORALMENTE; ver device-common.mk.
         (vendor.lineage.touch@1.0-service.samsung no es emitido por Soong;
         investigación N2 pendiente.) -->
<!-- Trust HAL — FIX-TRUST: entrada retirada.
     vendor.lineage.trust fue retirado del árbol de Lineage en versiones
     recientes, y el comentario original (FIX-026/TODO) ya decía "eliminar
     esta entrada si no se mantiene". Verificado: no hay ningún módulo
     vendor.lineage.trust en lineage-20.0 (0 resultados en Android.bp) y la
     interfaz IUsbRestrict solo aparece referenciada en CtsVerifier (app de
     pruebas, no incluida en el build) y en los manifests de framework.

     Igual que configstore, no hay servicio que se construya ni consumidor
     que espere, asi que no era un riesgo de cuelgue. Se retira la entrada
     para no dejar un <hal> declarado que no corresponde a nada. -->
    <!--FIX-TRUST     <hal format="hidl"> -->
    <!--FIX-TRUST         <name>vendor.lineage.trust</name> -->
    <!--FIX-TRUST         <transport>hwbinder</transport> -->
    <!--FIX-TRUST         <version>1.0</version> -->
    <!--FIX-TRUST         <interface> -->
    <!--FIX-TRUST             <name>IUsbRestrict</name> -->
    <!--FIX-TRUST             <instance>default</instance> -->
    <!--FIX-TRUST         </interface> -->
    <!--FIX-TRUST     </hal> -->

    <!-- ELIMINADAS respecto al manifest 17.1 (muertas en A13 o sin implementación planificada):
         - android.hardware.cas               (sin uso)
         - android.hardware.configstore       (RESTAURADO: ver FIX-CONFIGSTORE-RESTORE arriba; el servicio sí existe)
         - android.hardware.radio.deprecated  (se elimina en fase 5)
         - android.hardware.renderscript      (deprecado/eliminado en T)
         - vendor.lineage.power               (reemplazado por power HAL moderna) -->
</manifest>
