<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.settings.j2lte">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.MANAGE_USB" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_preferences"
        android:allowBackup="false">
        <activity
            android:name=".OptimizationsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- Aviso de "USB conectado" con las funciones disponibles. -->
        <receiver
            android:name=".OptimizationsActivity$UsbStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_STATE" />
            </intent-filter>
        </receiver>

        <!-- Accion de la notificacion: cambia la funcion USB. -->
        <receiver
            android:name=".OptimizationsActivity$UsbActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.android.settings.j2lte.SET_USB_FUNCTION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
