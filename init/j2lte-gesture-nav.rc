# Navegacion por botones fisicos por defecto.
# Mantener disponible el overlay gestual para poder cambiar desde Ajustes > Gestos.
on property:sys.boot_completed=1
    exec -- /system/bin/cmd overlay enable com.android.internal.systemui.navbar.threebutton
    exec -- /system/bin/cmd overlay disable com.android.internal.systemui.navbar.gestural_wide_back
    exec -- /system/bin/cmd overlay disable com.android.internal.systemui.navbar.gestural_extra_wide_back
    exec -- /system/bin/cmd overlay disable com.android.internal.systemui.navbar.gestural
    exec -- /system/bin/cmd overlay disable com.android.internal.systemui.navbar.gestural_narrow_back
    exec -- /system/bin/settings put secure navigation_mode 0
