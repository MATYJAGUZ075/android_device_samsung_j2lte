// RRO de "negro puro".
//
// En A13 AOSP el fondo del tema oscuro es #121212 (background_material_dark) y
// con el color dinamico de Material You el tono depende del wallpaper. En la
// linea 19/20 el tema oscuro era negro puro, y en un panel TN de 240 ppi se
// nota bastante.
//
// Se hace con dos RRO: uno sobre framework-res (cubre el framework, Ajustes,
// SystemUI y las apps del sistema) y otro sobre el launcher.
//
// El overlay NO es estatico: se habilita desde el init (ver
// PureBlack/pure-black.rc) igual que el de los gestos, de forma que si algo
// fuera mal se puede apagar sin tocar la build.
runtime_resource_overlay {
    name: "j2lte-pure-black-framework",
    product_specific: true,
    certificate: "platform",
    resource_dirs: ["framework/res"],
}

runtime_resource_overlay {
    name: "j2lte-pure-black-launcher",
    product_specific: true,
    certificate: "platform",
    resource_dirs: ["launcher/res"],
}
